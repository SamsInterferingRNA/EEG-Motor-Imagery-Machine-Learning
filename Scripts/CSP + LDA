"""
This code is the first implementation of the CSP + LDA classifier. 
It uses the "Path" import from pathlib to scan through the data and find runs 4, 8, and 12 for each subject.
For each of those runs, the code retains all 64 EEG channels, filters to the desired physiological frequencies,
trained the CSP + LDA and scores it via 5-fold cross-validation, and then plots accuracy per subject into a table. 
"""

import re
import warnings
from pathlib import Path
import mne
import numpy as np
import pandas as pd
from mne.decoding import CSP
from sklearn.discriminant_analysis import LinearDiscriminantAnalysis
from sklearn.model_selection import StratifiedKFold, cross_val_score
from sklearn.pipeline import make_pipeline

mne.set_log_level("WARNING")
warnings.filterwarnings("ignore", message="Concatenation of Annotations")


project_folder = Path(__file__).resolve().parent.parent
data_folder = project_folder / "Data"

IMAGERY_RUNS = [4, 8, 12]
EVENT_NAMES = {"TASK2T1": "LEFT", "TASK2T2": "RIGHT"}
EVENT_IDS = {"LEFT": 2, "RIGHT": 3}

FILTER_LOW, FILTER_HIGH = 8.0, 30.0
TMIN, TMAX = 0.5, 2.5
N_SPLITS = 5


def load_run_epochs(sub, run):
    stem = f"sub-{sub:03d}_task-motion_run-{run}"

    eeg_matches = list(data_folder.rglob(f"{stem}_eeg.set"))
    events_matches = list(data_folder.rglob(f"{stem}_events.tsv"))
    if not (eeg_matches and events_matches):
        print(f"  MISSING: sub-{sub:03d} run-{run}")
        return None

    raw = mne.io.read_raw_eeglab(eeg_matches[0], preload=True)

    raw.filter(FILTER_LOW, FILTER_HIGH)

    ev = pd.read_csv(events_matches[0], sep="\t")
    ev["condition"] = ev["value"].map(EVENT_NAMES)
    ev = ev.dropna(subset=["condition"])
    if ev.empty:
        return None

    events = np.column_stack([
        ev["sample"].astype(int),
        np.zeros(len(ev), dtype=int),
        ev["condition"].map(EVENT_IDS).astype(int),
    ])

    return mne.Epochs(
        raw, events, event_id=EVENT_IDS,
        tmin=TMIN, tmax=TMAX, baseline=None,
        picks="eeg", preload=True,
    )


def load_subject_epochs(sub):
    runs = []
    for run in IMAGERY_RUNS:
        ep = load_run_epochs(sub, run)
        if ep is not None:
            runs.append(ep)
    if not runs:
        return None
    return mne.concatenate_epochs(runs)


def find_subjects():
    numbers = set()
    for path in data_folder.rglob("sub-*_task-motion_run-4_eeg.set"):
        match = re.match(r"sub-(\d+)_", path.name)
        if match:
            numbers.add(int(match.group(1)))
    return sorted(numbers)


classifier = make_pipeline(
    CSP(n_components=4, reg="ledoit_wolf", log=True),
    LinearDiscriminantAnalysis(),
)

cv = StratifiedKFold(n_splits=N_SPLITS, shuffle=True, random_state=0)

subjects = find_subjects()
print(f"Found {len(subjects)} subjects with run 4: {subjects}\n")

results = []
for sub in subjects:
    print(f"sub-{sub:03d}")
    try:
        epochs = load_subject_epochs(sub)
        if epochs is None:
            continue

        X = epochs.get_data() * 1e6
        y = epochs.events[:, 2]

        n_left, n_right = int((y == 2).sum()), int((y == 3).sum())
        if min(n_left, n_right) < N_SPLITS:
            print(f"  skipped: too few trials (L={n_left}, R={n_right})")
            continue

        scores = cross_val_score(classifier, X, y, cv=cv)
        print(f"  trials L={n_left} R={n_right} | "
              f"channels={X.shape[1]} | accuracy={scores.mean():.2f}")

        results.append({
            "subject": sub,
            "n_left": n_left,
            "n_right": n_right,
            "accuracy": scores.mean(),
            "accuracy_std": scores.std(),
        })

    except Exception as err:
        print(f"  FAILED: {err}")

table = pd.DataFrame(results)
if table.empty:
    print("\nNo subjects were classified. Check the messages above.")
else:
    print("\n=== Accuracy per subject (chance = 0.50) ===")
    print(table.round(3).to_string(index=False))
    print(f"\nMean accuracy across subjects: {table['accuracy'].mean():.3f}")
    print(f"Subjects at or above 0.60:     {(table['accuracy'] >= 0.60).sum()} "
          f"of {len(table)}")

    out_file = project_folder / "results_within_subject.csv"
    table.to_csv(out_file, index=False)
    print(f"\nSaved to {out_file}")
